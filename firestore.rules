rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin or editor in the database
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'
      );
    }

    function isSuperAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Public Collections: Anyone can read, only Admin can write (with view_count exception)
    match /posts/{post} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']);
    }

    match /profiles/{profile} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['view_count', 'follower_count']));
    }

    match /listings/{listing} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']);
    }

    match /resources/{resource} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']);
    }

    match /guides/{guide} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /faq_categories/{category} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /glossary/{term} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /code_snippets/{snippet} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Taxonomies: Public read, Admin write
    match /industries/{industry} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cities/{city} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /likes/{likeId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }
    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null; // Allowed to check if own bookmark exists
      allow write: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }
    match /site_settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /blog_categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /listing_types/{id} { allow read: if true; allow write: if isAdmin(); }
    match /authors/{id} { allow read: if true; allow write: if isAdmin(); }
    match /startup_stages/{stage} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: Public read, Super Admin write
    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users: User can read/write their own profile (limit what they can write)
    // Admin can read/write everything
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isSuperAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isSuperAdmin();
    }

    // AI System Collections
    // AI Configs: User can only read/write their own encrypted API keys
    match /ai_configs/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // AI Posts: Users manage their own posts, admins can view all
    match /ai_posts/{postId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // AI Logs: Users can only read their own logs
    // Backend writes logs with firebase-admin (bypasses rules)
    match /ai_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false; // Backend only, uses Admin SDK
    }

    // Comments: Public can read and create, only admins can update/delete
    match /comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Comment Reports: Anyone can create, only admins can read/update/delete
    match /comment_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
