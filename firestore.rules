rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor'
      );
    }

    function isSuperAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- Submissions Collection (User Dashboard & Guest Forms) ---
    match /submissions/{subId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && (request.auth.token.email == resource.data.email || request.auth.uid == resource.data.userId));
      allow update, delete: if isAdmin();
    }

    // --- Public Collections (Public Read, Public/User Pending Create, Admin Write, View Count Updates) ---
    match /posts/{post} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.status == 'pending';
      allow delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /profiles/{profile} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.status == 'pending';
      allow delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) 
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['follower_count']) 
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count', 'follower_count']) 
                    || isAdmin();
    }

    match /listings/{listing} {
      allow read: if true;
      allow create: if isAdmin() || request.resource.data.status == 'pending';
      allow delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /resources/{resource} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /knowledge/{article} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /guides/{guide} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /faq_categories/{category} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /glossary/{term} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['view_count']) || isAdmin();
    }

    match /code_snippets/{snippet} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // --- Taxonomies & Categories (Public Read, Admin Write) ---
    match /industries/{industry} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cities/{city} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /blog_categories/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /listing_types/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /startup_stages/{stage} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /employee_sizes/{size} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /authors/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /media/{item} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{id} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /settings/{setting} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- User Interactions ---
    match /likes/{likeId} {
      allow read: if true;
      allow write: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }

    match /bookmarks/{bookmarkId} {
      allow read: if request.auth != null;
      allow write: if isOwner(request.resource.data.userId) || isOwner(resource.data.userId);
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        isSuperAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isSuperAdmin();
    }

    // --- AI System Collections ---
    match /ai_configs/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /ai_posts/{postId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /ai_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid || isAdmin();
      allow write: if false;
    }

    match /comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // --- SEO & Traffic Management ---
    match /redirects/{redirectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /dead_links/{linkId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /comment_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Contact Messages ---
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

  }
}
