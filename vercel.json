{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "env": {
    "SKIP_ENV_VALIDATION": "true"
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-handler?action=sitemap"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "/api/seo-handler?action=sitemap-news"
    },
    {
      "source": "/api/og-image",
      "destination": "/api/seo-handler?render=image"
    },
    {
      "source": "/api/ai/generate",
      "destination": "/api/ai/ai-router?target=generate"
    },
    {
      "source": "/api/ai/copilot",
      "destination": "/api/ai/ai-router?target=copilot"
    },
    {
      "source": "/api/ai/stats",
      "destination": "/api/ai/ai-router?target=stats"
    },
    {
      "source": "/api/ai/posts-handler",
      "destination": "/api/ai/ai-router?target=posts"
    },
    {
      "source": "/api/ai/providers-handler",
      "destination": "/api/ai/ai-router?target=providers"
    },
    {
      "source": "/api/list-r2",
      "destination": "/api/media-handler?action=list"
    },
    {
      "source": "/api/upload-url",
      "destination": "/api/media-handler?action=upload"
    },
    {
      "source": "/api/optimize-image",
      "destination": "/api/media-handler?action=optimize"
    },
    {
      "source": "/api/delete-r2-image",
      "destination": "/api/media-handler?action=delete"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebookexternalhit|whatsapp|google-marketing-platform|twitterbot|messenger|slackbot|linkedinbot|embedly|quora link preview|outbrain|pinterest\\/0\\.|bingbot|msnbot|bingpreview|googlebot|adsbot-google|twitterbot|pinterest|baiduspider|yandexbot|facebookexternalhit|metainspector).*"
        }
      ],
      "destination": "/api/seo-handler?path=blog/:slug"
    },
    {
      "source": "/directory/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebookexternalhit|whatsapp|google-marketing-platform|twitterbot|messenger|slackbot|linkedinbot|embedly|quora link preview|outbrain|pinterest\\/0\\.|bingbot|msnbot|bingpreview|googlebot|adsbot-google|twitterbot|pinterest|baiduspider|yandexbot|facebookexternalhit|metainspector).*"
        }
      ],
      "destination": "/api/seo-handler?path=directory/:slug"
    },
    {
      "source": "/entrepreneurs/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebookexternalhit|whatsapp|google-marketing-platform|twitterbot|messenger|slackbot|linkedinbot|embedly|quora link preview|outbrain|pinterest\\/0\\.|bingbot|msnbot|bingpreview|googlebot|adsbot-google|twitterbot|pinterest|baiduspider|yandexbot|facebookexternalhit|metainspector).*"
        }
      ],
      "destination": "/api/seo-handler?path=entrepreneurs/:slug"
    },
    {
      "source": "/knowledge/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|facebookexternalhit|whatsapp|google-marketing-platform|twitterbot|messenger|slackbot|linkedinbot|embedly|quora link preview|outbrain|pinterest\\/0\\.|bingbot|msnbot|bingpreview|googlebot|adsbot-google|twitterbot|pinterest|baiduspider|yandexbot|facebookexternalhit|metainspector).*"
        }
      ],
      "destination": "/api/seo-handler?path=knowledge/:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}