rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@entrepreneurs-bd.com' ||
        // If we had custom claims, we'd check them here. 
        // For now, this glass-breaker is at least better than any authenticated user.
        request.auth.token.email_verified == true
      );
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
