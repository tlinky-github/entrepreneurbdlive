---
// Base layout for all public pages
import '../styles/globals.css';
import AdminToolbar from '../components/AdminToolbar.jsx';
import { getSiteSettings } from '../lib/serverApi';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  noIndex?: boolean;
  schema?: any;
  robotsMeta?: string;
  socialMeta?: any;
}

let siteSettings = null;
try {
  siteSettings = await getSiteSettings();
} catch (e) {
  console.error('[BaseLayout] Settings fetch error:', e);
}

const siteName = siteSettings?.site_name || 'Entrepreneur BD';
const siteTagline = siteSettings?.site_tagline || 'Bangladesh Entrepreneur Ecosystem';
const logoUrl = siteSettings?.logo_url || '';
const faviconUrl = siteSettings?.favicon_url || '';
const footerText = siteSettings?.footer_text || `© ${new Date().getFullYear()} ${siteName}. All rights reserved.`;

const contactEmail = siteSettings?.contact_email || '';
const contactPhone = siteSettings?.contact_phone || '';
const address = siteSettings?.address || '';

const facebookUrl = siteSettings?.facebook;
const twitterUrl = siteSettings?.twitter;
const linkedinUrl = siteSettings?.linkedin;
const youtubeUrl = siteSettings?.youtube;
const googleAnalyticsId = siteSettings?.google_analytics_id;

const {
  title,
  description = siteSettings?.seo_description || "Connect with entrepreneurs, discover startups, and access resources for business growth in Bangladesh.",
  image = '/og-default.png',
  type = 'website',
  canonical,
  noIndex = false,
  schema,
  robotsMeta,
  socialMeta,
} = Astro.props;

const siteUrl = 'https://entrepreneurs.bd';
const currentUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {faviconUrl ? (
    <link rel="icon" href={faviconUrl} />
  ) : (
    <>
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" type="image/png" sizes="32x32" href="/logo192.png" />
      <link rel="icon" type="image/x-icon" href="/favicon.ico" />
      <link rel="apple-touch-icon" sizes="180x180" href="/logo192.png" />
    </>
  )}
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#064e3b" />

  {googleAnalyticsId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
      <script set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${googleAnalyticsId}');
      `} />
    </>
  )}

  <!-- SEO — rendered at build/request time, no JS needed -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={currentUrl} />
  {robotsMeta ? (
    <meta name="robots" content={robotsMeta} />
  ) : (
    noIndex && <meta name="robots" content="noindex, nofollow" />
  )}

  <!-- Open Graph -->
  <meta property="og:site_name" content={siteName} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={socialMeta?.ogTitle || title} />
  <meta property="og:description" content={socialMeta?.ogDescription || description} />
  <meta property="og:image" content={socialMeta?.ogImage || ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={currentUrl} />

  <!-- Twitter -->
  <meta name="twitter:card" content={socialMeta?.twitterCard || "summary_large_image"} />
  <meta name="twitter:site" content="@entrepreneursbd" />
  <meta name="twitter:title" content={socialMeta?.twitterTitle || socialMeta?.ogTitle || title} />
  <meta name="twitter:description" content={socialMeta?.twitterDescription || socialMeta?.ogDescription || description} />
  <meta name="twitter:image" content={socialMeta?.twitterImage || socialMeta?.ogImage || ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Structured Data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}

  <slot name="head" />
</head>
<body class="min-h-screen bg-stone-50 text-stone-900 font-sans antialiased">
  <AdminToolbar client:only="react" />

  <!-- Header (React island for interactivity) -->
  <slot name="header">
    <Fragment set:html={`<!-- Default header placeholder -->`} />
  </slot>

  <!-- Main content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-stone-900 text-stone-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Main Footer Content -->
      <div class="py-12 lg:py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
        <!-- Brand Column -->
        <div class="lg:col-span-2">
          <a href="/" class="flex items-center gap-2 mb-4">
            {logoUrl ? (
              <img src={logoUrl} alt={siteName} class="h-10 object-contain" />
            ) : (
              <>
                <div class="w-10 h-10 bg-emerald-600 rounded-lg flex items-center justify-center">
                  <span class="text-white font-bold text-xl">{siteName.charAt(0).toLowerCase()}</span>
                </div>
                <div>
                  <span class="font-bold text-lg text-white">{siteName}</span>
                </div>
              </>
            )}
          </a>
          <p class="text-stone-400 mb-6 max-w-sm">
            {siteTagline}
          </p>
          <div class="flex gap-4">
            {facebookUrl && (
              <a
                href={facebookUrl}
                class="w-10 h-10 bg-stone-800 hover:bg-emerald-900 rounded-lg flex items-center justify-center transition-colors"
                aria-label="Facebook"
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            )}
            {twitterUrl && (
              <a
                href={twitterUrl}
                class="w-10 h-10 bg-stone-800 hover:bg-emerald-900 rounded-lg flex items-center justify-center transition-colors"
                aria-label="Twitter"
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.936 9.936 0 0024 4.59z"/></svg>
              </a>
            )}
            {linkedinUrl && (
              <a
                href={linkedinUrl}
                class="w-10 h-10 bg-stone-800 hover:bg-emerald-900 rounded-lg flex items-center justify-center transition-colors"
                aria-label="LinkedIn"
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            )}
            {youtubeUrl && (
              <a
                href={youtubeUrl}
                class="w-10 h-10 bg-stone-800 hover:bg-emerald-900 rounded-lg flex items-center justify-center transition-colors"
                aria-label="YouTube"
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            )}
          </div>
        </div>

        <!-- Platform Column -->
        <div>
          <h4 class="font-semibold text-white mb-4">Platform</h4>
          <ul class="space-y-3">
            <li><a href="/knowledge" class="text-stone-400 hover:text-emerald-500 transition-colors">Knowledge Hub</a></li>
            <li><a href="/blog" class="text-stone-400 hover:text-emerald-500 transition-colors">Blog</a></li>
            <li><a href="/entrepreneurs" class="text-stone-400 hover:text-emerald-500 transition-colors">Entrepreneurs</a></li>
            <li><a href="/directory" class="text-stone-400 hover:text-emerald-500 transition-colors">Directory</a></li>
          </ul>
        </div>

        <!-- Resources Column -->
        <div>
          <h4 class="font-semibold text-white mb-4">Resources</h4>
          <ul class="space-y-3">
            <li><a href="/resources/guides" class="text-stone-400 hover:text-emerald-500 transition-colors">Practical Guides</a></li>
            <li><a href="/resources/faqs" class="text-stone-400 hover:text-emerald-500 transition-colors">FAQs</a></li>
            <li><a href="/resources/glossary" class="text-stone-400 hover:text-emerald-500 transition-colors">Glossary</a></li>
          </ul>
        </div>

        <!-- Company Column -->
        <div>
          <h4 class="font-semibold text-white mb-4">Company</h4>
          <ul class="space-y-3">
            <li><a href="/about" class="text-stone-400 hover:text-emerald-500 transition-colors">About Us</a></li>
            <li><a href="/editorial" class="text-stone-400 hover:text-emerald-500 transition-colors">Editorial Principles</a></li>
            <li><a href="/contact" class="text-stone-400 hover:text-emerald-500 transition-colors">Contact</a></li>
            <li><a href="/privacy" class="text-stone-400 hover:text-emerald-500 transition-colors">Privacy Policy</a></li>
            <li><a href="/terms" class="text-stone-400 hover:text-emerald-500 transition-colors">Terms of Service</a></li>
            <li><a href="/disclaimer" class="text-stone-400 hover:text-emerald-500 transition-colors">Disclaimer</a></li>
          </ul>
        </div>
      </div>

      <!-- Contact Bar -->
      <div class="py-6 border-t border-stone-800 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-wrap justify-center gap-6 text-sm">
          {contactEmail && (
            <a href={`mailto:${contactEmail}`} class="flex items-center gap-2 hover:text-emerald-500 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {contactEmail}
            </a>
          )}
          {contactPhone && (
            <a href={`tel:${contactPhone}`} class="flex items-center gap-2 hover:text-emerald-500 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {contactPhone}
            </a>
          )}
          {address && (
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {address}
            </span>
          )}
        </div>
      </div>

      <!-- Copyright -->
      <div class="py-6 border-t border-stone-800 text-center text-sm text-stone-500">
        <p>{footerText}</p>
      </div>
    </div>
  </footer>
</body>
</html>
