---
// Public page layout — wraps BaseLayout with the Header island
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.jsx';
import { getSiteSettings } from '../lib/serverApi';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  noIndex?: boolean;
  schema?: any;
  robotsMeta?: string;
  socialMeta?: any;
}

const props = Astro.props;
const currentPath = Astro.url.pathname;

let initialSiteSettings = null;
try {
  initialSiteSettings = await getSiteSettings();
} catch (e) {}
---

<BaseLayout {...props}>
  <Header slot="header" currentPath={currentPath} initialSiteSettings={initialSiteSettings} client:load />
  <slot />
</BaseLayout>
