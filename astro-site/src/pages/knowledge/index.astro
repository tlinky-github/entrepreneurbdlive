---
import PublicLayout from '../../layouts/PublicLayout.astro';
import KnowledgeHubPage from '../../components/knowledge/KnowledgeHubPage.jsx';
import { contentAPI } from '../../lib/serverApi';

let firestoreArticles = [];
try {
  firestoreArticles = await contentAPI.list();
} catch (e: any) {
  console.error('[Knowledge Hub] SSR fetch failed:', e.message);
}
---

<PublicLayout
  title="Knowledge Hub | Entrepreneur BD"
  description="Your complete resource library for building and growing a successful business."
>
  <KnowledgeHubPage client:load firestoreArticles={firestoreArticles} />
</PublicLayout>
