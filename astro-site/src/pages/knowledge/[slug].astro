---
import PublicLayout from '../../layouts/PublicLayout.astro';
import KnowledgeArticlePage from '../../components/knowledge/KnowledgeArticlePage.jsx';
import { getDocBySlug } from '../../lib/serverApi';
import { pillarPages, pillarPagesPart2 } from '../../data/mock';
import { buildSchema, interpolateSEOVariables, getRobotsMetaString } from '../../lib/schema';

const { slug } = Astro.params;

let article = null;
let isFirestore = false;

// 1. Try Firestore
try {
  article = await getDocBySlug('resources', slug as string);
  if (article) {
    isFirestore = true;
    
    // Cookie-controlled view counting
    if (article.id) {
      const cookieName = `viewed_res_${article.id}`;
      if (!Astro.cookies.has(cookieName)) {
        Astro.cookies.set(cookieName, '1', {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 // 24 hours
        });
        // Increment views on firestore
        const { incrementViewCount } = await import('../../lib/serverApi');
        incrementViewCount('resources', article.id);
      }
    }
  }
} catch (e) {
  console.error('[Knowledge Article] Firestore fetch failed:', e);
}

// 2. Try mock/pillar pages
if (!article) {
  const allPillarPages = [...pillarPages, ...pillarPagesPart2];
  article = allPillarPages.find(p => p.id === slug);
}

// Handle redirects if configured in RankMath advanced settings
if (article && article.redirection && article.redirection.enable && article.redirection.url) {
  const redirectStatus = parseInt(article.redirection.type) || 301;
  return Astro.redirect(article.redirection.url, redirectStatus);
}

// SEO metadata with RankMath support
const rawTitleTemplate = article?.seo_title || article?.seoTitle || "%title% %sep% %sitename%";
const rawDescTemplate = article?.seo_description || article?.seoDescription || "%excerpt%";

const siteTitleVal = article?.title || 'Knowledge Hub Article';
const siteExcerptVal = article?.description || article?.subtitle || '';

const title = article ? interpolateSEOVariables(rawTitleTemplate, siteTitleVal, siteExcerptVal) : 'Knowledge Hub Article | Entrepreneurs BD';
const description = article ? interpolateSEOVariables(rawDescTemplate, siteTitleVal, siteExcerptVal) : 'Read this business knowledge article on Entrepreneurs BD.';

const image = article?.og_image || article?.featured_image || '';
const canonical = article?.canonical_url || article?.canonicalUrl || undefined;
const robotsMeta = article ? getRobotsMetaString(article.robots_meta) : undefined;
const socialMeta = article?.social_meta || undefined;

// Generate Schema
const pageSchema = buildSchema(article?.custom_schema, null, authorData, article?.content_html || article?.content);
---

<PublicLayout
  title={title}
  description={description}
  image={image || undefined}
  schema={pageSchema}
  canonical={canonical}
  robotsMeta={robotsMeta}
  socialMeta={socialMeta}
>
  <KnowledgeArticlePage client:load slug={slug} article={article} isFirestore={isFirestore} />
</PublicLayout>
