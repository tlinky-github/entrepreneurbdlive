---
export const prerender = false;
import PublicLayout from '../../layouts/PublicLayout.astro';
import KnowledgeArticlePage from '../../components/knowledge/KnowledgeArticlePage.jsx';
import { getDocBySlug, getPublishedDocs, incrementViewCount } from '../../lib/serverApi';
import { buildSchema, interpolateSEOVariables, getRobotsMetaString } from '../../lib/schema';

const { slug } = Astro.params;

let article = null;
let isFirestore = false;

// 1. Try Firestore ('knowledge' collection first, then 'resources')
try {
  if (!article) {
    article = await getDocBySlug('knowledge', slug as string);
  }
  if (!article) {
    article = await getDocBySlug('resources', slug as string);
  }
  if (article) {
    isFirestore = true;
  }
} catch (e) {
  console.error('[Knowledge Article] Firestore fetch failed:', e);
}

// Handle redirects if configured in RankMath advanced settings
if (article && article.redirection && article.redirection.enable && article.redirection.url) {
  const redirectStatus = parseInt(article.redirection.type) || 301;
  return Astro.redirect(article.redirection.url, redirectStatus);
}

// Prepare authorData safely for schema generation
const authorData = article?.author_name ? {
  name: article.author_name,
  designation: article.author_designation || 'Official Author',
  photo: article.author_photo || '',
  slug: article.author_slug || ''
} : null;

// SEO metadata with RankMath support
const rawTitleTemplate = article?.seo_title || article?.seoTitle || "%title% %sep% %sitename%";
const rawDescTemplate = article?.seo_description || article?.seoDescription || "%excerpt%";

const siteTitleVal = article?.title || 'Knowledge Hub Article';
const siteExcerptVal = article?.excerpt || article?.description || article?.subtitle || '';

const title = article ? interpolateSEOVariables(rawTitleTemplate, siteTitleVal, siteExcerptVal) : 'Knowledge Hub Article | Entrepreneurs BD';
const description = article ? interpolateSEOVariables(rawDescTemplate, siteTitleVal, siteExcerptVal) : 'Read this business knowledge article on Entrepreneurs BD.';

const image = article?.og_image || article?.featured_image || '';
const canonical = article?.canonical_url || article?.canonicalUrl || undefined;
const robotsMeta = article ? getRobotsMetaString(article.robots_meta) : undefined;
const socialMeta = article?.social_meta || undefined;

// Generate Schema
const pageSchema = buildSchema(article?.custom_schema, null, authorData, article?.content_html || article?.content);
// Serialize Firestore article to break cyclic references (Timestamps, DocumentReferences, etc.)
function serializeFirestore(obj: any, depth = 0): any {
  if (depth > 20 || obj === null || obj === undefined) return obj ?? null;
  if (typeof obj !== 'object') return obj;
  // Firestore Timestamp
  if (typeof obj.toDate === 'function') return obj.toDate().toISOString();
  // Firestore DocumentReference
  if (obj._path || obj.firestore) return null;
  if (Array.isArray(obj)) return obj.map((item) => serializeFirestore(item, depth + 1));
  const result: Record<string, any> = {};
  for (const [key, val] of Object.entries(obj)) {
    try {
      result[key] = serializeFirestore(val, depth + 1);
    } catch {
      result[key] = null;
    }
  }
  return result;
}

const safeArticle = article ? serializeFirestore(article) : null;
---

<PublicLayout
  title={title}
  description={description}
  image={image || undefined}
  schema={pageSchema}
  canonical={canonical}
  robotsMeta={robotsMeta}
  socialMeta={socialMeta}
>
  <KnowledgeArticlePage client:load slug={slug} article={safeArticle} isFirestore={isFirestore} />
</PublicLayout>
