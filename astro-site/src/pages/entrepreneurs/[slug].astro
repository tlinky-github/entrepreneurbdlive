---
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntrepreneurDetail from '../../components/entrepreneurs/EntrepreneurDetail.jsx';
import { profileAPI, authorAPI, taxonomyAPI } from '../../lib/serverApi';
import { getPersonSchema, buildSchema, interpolateSEOVariables, getRobotsMetaString } from '../../lib/schema';

const { slug } = Astro.params;

let profile = null;
let authorData = null;
let startupStages = [];

try {
  const [profileRes, stagesRes] = await Promise.all([
    profileAPI.get(slug as string),
    taxonomyAPI.list('startup_stages')
  ]);
  profile = profileRes.data;
  startupStages = stagesRes.data || [];

  if (profile && profile.id) {
    const cookieName = `viewed_ent_${profile.id}`;
    if (!Astro.cookies.has(cookieName)) {
      Astro.cookies.set(cookieName, '1', {
        path: '/',
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 // 24 hours
      });
      // Increment views on firestore
      const { incrementViewCount } = await import('../../lib/serverApi');
      incrementViewCount('profiles', profile.id);
    }
  }
  
  if (profile?.authorId) {
    try {
      const authorRes = await authorAPI.get(profile.authorId);
      authorData = authorRes.data;
    } catch (err: any) {
      console.error('[Entrepreneur Detail] Author fetch failed:', err.message);
    }
  }
} catch (e: any) {
  console.error('[Entrepreneur Detail] Profile fetch failed:', e.message);
}

// Handle redirects if configured in RankMath advanced settings
if (profile && profile.redirection && profile.redirection.enable && profile.redirection.url) {
  const redirectStatus = parseInt(profile.redirection.type) || 301;
  return Astro.redirect(profile.redirection.url, redirectStatus);
}

const profileImg = profile?.og_image || profile?.featured_image || profile?.photo || '';

// SEO metadata with RankMath support
const rawTitleTemplate = profile?.seo_title || profile?.seoTitle || "%title% %sep% %sitename%";
const rawDescTemplate = profile?.seo_description || profile?.seoDescription || "%excerpt%";

const siteTitleVal = profile?.name || 'Entrepreneur Profile';
const siteExcerptVal = profile?.short_bio || profile?.details || '';

const title = profile ? interpolateSEOVariables(rawTitleTemplate, siteTitleVal, siteExcerptVal) : 'Entrepreneur Profile | Entrepreneurs BD';
const description = profile ? interpolateSEOVariables(rawDescTemplate, siteTitleVal, siteExcerptVal) : 'View the profile and journey of this entrepreneur on Entrepreneurs BD.';

const canonical = profile?.canonical_url || profile?.canonicalUrl || undefined;
const robotsMeta = profile ? getRobotsMetaString(profile.robots_meta) : undefined;
const socialMeta = profile?.social_meta || undefined;

// Generate Schema
const defaultSchema = profile ? getPersonSchema(profile) : null;
const pageSchema = buildSchema(profile?.custom_schema, defaultSchema, authorData, profile?.content_html || profile?.content || profile?.details);
---

<PublicLayout
  title={title}
  description={description}
  image={profileImg || undefined}
  schema={pageSchema}
  canonical={canonical}
  robotsMeta={robotsMeta}
  socialMeta={socialMeta}
>
  <EntrepreneurDetail client:load slug={slug} initialProfile={profile} initialAuthorData={authorData} startupStages={startupStages} />
</PublicLayout>
