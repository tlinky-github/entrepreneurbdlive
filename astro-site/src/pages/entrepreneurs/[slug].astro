---
import PublicLayout from '../../layouts/PublicLayout.astro';
import EntrepreneurDetail from '../../components/entrepreneurs/EntrepreneurDetail.jsx';
import { profileAPI, authorAPI, taxonomyAPI } from '../../lib/api';

const { slug } = Astro.params;

let profile = null;
let authorData = null;
let startupStages = [];

try {
  const [profileRes, stagesRes] = await Promise.all([
    profileAPI.get(slug as string),
    taxonomyAPI.list('startup_stages')
  ]);
  profile = profileRes.data;
  startupStages = stagesRes.data || [];
  
  if (profile?.authorId) {
    try {
      const authorRes = await authorAPI.get(profile.authorId);
      authorData = authorRes.data;
    } catch (err: any) {
      console.error('[Entrepreneur Detail] Author fetch failed:', err.message);
    }
  }
} catch (e: any) {
  console.error('[Entrepreneur Detail] Profile fetch failed:', e.message);
}

// SEO metadata
const title = profile?.name ? `${profile.name} | Entrepreneur BD Profile` : 'Entrepreneur Profile | Entrepreneur BD';
const description = profile?.short_bio || 'View the profile and journey of this entrepreneur on Entrepreneur BD.';
---

<PublicLayout
  title={title}
  description={description}
>
  <EntrepreneurDetail client:load slug={slug} initialProfile={profile} initialAuthorData={authorData} startupStages={startupStages} />
</PublicLayout>
