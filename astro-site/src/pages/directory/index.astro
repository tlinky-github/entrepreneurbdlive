---
import PublicLayout from '../../layouts/PublicLayout.astro';
import DirectoryList from '../../components/directory/DirectoryList.jsx';
import { getPublishedDocs, taxonomyAPI, getSiteSettings } from '../../lib/serverApi';

let initialListings = [];
let listingTypes = [];
let categories = [];
let perPage = 12;

try {
  const settings = await getSiteSettings();
  perPage = parseInt(settings?.directory_per_page) || 12;

  const [lDocs, typesRes, catRes] = await Promise.all([
    getPublishedDocs('listings', perPage),
    taxonomyAPI.getByCollection('listing_types'),
    taxonomyAPI.getByCollection('categories')
  ]);
  initialListings = lDocs || [];
  listingTypes = typesRes || [];
  categories = catRes || [];
} catch (e) {}
---

<PublicLayout
  title="Business Directory | Entrepreneurs BD"
  description="Discover the most ambitious businesses and entrepreneurs across Bangladesh. Connect, collaborate, and grow with our verified community."
>
  <DirectoryList 
    client:load 
    initialListings={initialListings} 
    initialListingTypes={listingTypes} 
    initialCategories={categories} 
    initialPerPage={perPage}
  />
</PublicLayout>
