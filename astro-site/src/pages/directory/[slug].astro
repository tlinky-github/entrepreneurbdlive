---
import PublicLayout from '../../layouts/PublicLayout.astro';
import DirectoryDetail from '../../components/directory/DirectoryDetail.jsx';
import { listingAPI, taxonomyAPI } from '../../lib/serverApi';

const { slug } = Astro.params;

let listing = null;
let startupStages = [];

try {
  const [listingRes, stagesRes] = await Promise.all([
    listingAPI.get(slug as string),
    taxonomyAPI.list('startup_stages')
  ]);
  listing = listingRes.data;
  startupStages = stagesRes.data || [];
} catch (e: any) {
  console.error('[Directory Detail] Fetch failed:', e.message);
}

// SEO metadata
const title = listing?.business_name ? `${listing.business_name} | Entrepreneur BD Directory` : 'Business Detail | Entrepreneur BD';
const description = listing?.short_description || 'View detailed information about this business on Entrepreneur BD.';
---

<PublicLayout
  title={title}
  description={description}
>
  <DirectoryDetail client:load slug={slug} initialListing={listing} startupStages={startupStages} />
</PublicLayout>
