---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  title="Page Not Found | Entrepreneurs BD"
  description="The page you are looking for doesn't exist or has been moved."
  noIndex={true}
>
  <div class="min-h-[80vh] flex items-center justify-center bg-gradient-to-br from-stone-50 via-white to-emerald-50/30 px-4 py-20">
    <div class="max-w-2xl mx-auto text-center">

      <!-- Animated 404 Number -->
      <div class="relative mb-8 select-none">
        <div class="text-[10rem] sm:text-[14rem] font-black leading-none text-transparent bg-clip-text bg-gradient-to-br from-emerald-900 via-emerald-700 to-emerald-500 opacity-10 absolute inset-0 flex items-center justify-center pointer-events-none">
          404
        </div>
        <div class="relative flex items-center justify-center gap-2 sm:gap-4">
          <span class="text-7xl sm:text-9xl font-black text-emerald-900 drop-shadow-sm">4</span>
          <!-- Spinning icon in the middle -->
          <div class="relative w-20 h-20 sm:w-28 sm:h-28 flex items-center justify-center">
            <div class="absolute inset-0 rounded-full bg-emerald-900/10 animate-ping" style="animation-duration: 2s;"></div>
            <div class="w-16 h-16 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-emerald-900 to-emerald-600 flex items-center justify-center shadow-2xl shadow-emerald-900/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 sm:w-12 sm:h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
              </svg>
            </div>
          </div>
          <span class="text-7xl sm:text-9xl font-black text-emerald-900 drop-shadow-sm">4</span>
        </div>
      </div>

      <!-- Message -->
      <div class="mb-10">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900 mb-4 tracking-tight">
          This page doesn't exist
        </h1>
        <p class="text-lg text-stone-500 leading-relaxed max-w-md mx-auto">
          The page you're looking for may have been moved, deleted, or the URL might be incorrect.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-emerald-900 text-white font-bold text-base hover:bg-emerald-800 transition-all duration-200 shadow-lg shadow-emerald-900/20 hover:shadow-emerald-900/30 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Go to Homepage
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl border-2 border-stone-200 text-stone-700 font-bold text-base hover:border-emerald-900 hover:text-emerald-900 transition-all duration-200 hover:-translate-y-0.5 w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Browse Articles
        </a>
      </div>

      <!-- Quick Links -->
      <div class="border-t border-stone-200 pt-10">
        <p class="text-sm font-semibold text-stone-400 uppercase tracking-widest mb-6">Quick links</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {[
            { href: '/directory', label: 'Directory', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
            { href: '/entrepreneurs', label: 'Entrepreneurs', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
            { href: '/knowledge', label: 'Knowledge Hub', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
            { href: '/contact', label: 'Contact Us', icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
          ].map(link => (
            <a
              href={link.href}
              class="flex flex-col items-center gap-2 p-4 rounded-xl border border-stone-100 hover:border-emerald-200 hover:bg-emerald-50/50 transition-all duration-200 group"
            >
              <div class="w-10 h-10 rounded-lg bg-stone-100 group-hover:bg-emerald-100 flex items-center justify-center transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-stone-500 group-hover:text-emerald-700 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={link.icon} />
                </svg>
              </div>
              <span class="text-sm font-semibold text-stone-600 group-hover:text-emerald-800 transition-colors">{link.label}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</PublicLayout>
