---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getDocBySlug, stripHtml } from '../../lib/api';
import { processHtmlContent } from '../../lib/smartDesign';
import { Badge } from '../../components/ui/badge.jsx';
import { Calendar, Clock, ArrowLeft } from 'lucide-react';

const { slug } = Astro.params;

// Fetch post from Firestore on the server
const post = await getDocBySlug('posts', slug as string);

// If no post is found, return 404
if (!post) {
  return new Response('Post not found', { status: 404 });
}

// Generate SEO metadata
const title = post.seoTitle || post.title || 'Blog Post';
const description = post.metaDescription || stripHtml(post.excerpt || post.content_html).substring(0, 160);
const image = post.featured_image || '/og-default.png';

// Format Date exactly as in React
const publishedDate = post.created_at ? new Date(post.created_at).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : '';

function getReadingTime(post) {
  const content = post.content || post.content_html || '';
  return Math.ceil(stripHtml(content).split(/\s+/).length / 200) || 1;
}

// Process the raw HTML with the exact Smart Design pipeline from the React app
const finalContentHtml = processHtmlContent(post.content_html || post.content || '', post.featured_image, post.title);

---

<PublicLayout 
  title={`${title} | Entrepreneurs BD`}
  description={description}
  image={image}
  type="article"
>
  <div class="bg-stone-50 min-h-screen" data-testid="blog-detail-page">
    
    <!-- Back Button -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <a href="/blog" class="inline-flex items-center gap-2 text-stone-600 hover:text-emerald-900 transition-colors">
        <ArrowLeft className="w-4 h-4" />
        Back to Blog
      </a>
    </div>

    <!-- Article Header -->
    <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <header class="mb-8">
        {post.category_name && (
          <Badge className="bg-emerald-100 text-emerald-900 hover:bg-emerald-100 mb-4">{post.category_name}</Badge>
        )}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-stone-900 mb-6 leading-tight">
          {post.title}
        </h1>
        {post.excerpt && (
          <p class="text-xl text-stone-600 mb-6">{post.excerpt}</p>
        )}

        <div class="flex flex-wrap items-center gap-6 text-sm text-stone-500 pb-6 border-b border-stone-200">
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-900 flex items-center justify-center font-bold text-sm">
                {(post.author_name || 'E').charAt(0).toUpperCase()}
              </div>
              <div>
                <p class="font-medium text-stone-900">{post.author_name || 'Entrepreneurs BD'}</p>
                <p class="text-xs">Author</p>
              </div>
            </div>
          </div>
          
          {publishedDate && (
            <div class="flex items-center gap-2">
              <Calendar className="w-4 h-4" />
              {publishedDate}
            </div>
          )}
          
          <div class="flex items-center gap-2">
            <Clock className="w-4 h-4" />
            {getReadingTime(post)} min read
          </div>
        </div>
      </header>

      <!-- Processed Article Content (Includes injected featured image and FAQs) -->
      <div class="tiptap-content">
        <div class="prose prose-stone max-w-none prose-h2:text-2xl prose-h2:font-black prose-p:text-stone-800 prose-p:leading-relaxed prose-p:text-lg" set:html={finalContentHtml}></div>
      </div>
      
    </article>
  </div>
</PublicLayout>
