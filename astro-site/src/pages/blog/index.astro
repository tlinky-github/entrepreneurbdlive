---
// Blog List — fetches published posts from Firestore at request time (SSR)
// This strictly matches BlogList.jsx with 100% UI parity
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getRecentPosts, getCategories, stripHtml } from '../../lib/serverApi';
import { decodeHtmlEntities } from '../../lib/smartDesign';
import BlogFilters from '../../components/blog/BlogFilters.jsx';
import BrandedPlaceholder from '../../components/blog/BrandedPlaceholder.jsx';
import { Card, CardContent } from '../../components/ui/card.jsx';
import { Badge } from '../../components/ui/badge.jsx';
import { User, Clock } from 'lucide-react';
import SitePagination from '../../components/common/SitePagination.jsx';

// Get URL params for SSR filtering
const search = Astro.url.searchParams.get('search') || '';
const categoryParam = Astro.url.searchParams.get('category') || '';
const pageParam = parseInt(Astro.url.searchParams.get('page')) || 1;
const ITEMS_PER_PAGE = 12;

let posts = [];
let categories = [];
let error = null;
let initialCategoryValue = '';

try {
  // Fetch data
  const [allPosts, allCats] = await Promise.all([
    getRecentPosts(100), // Get enough posts to filter
    getCategories()
  ]);
  
  categories = allCats;

  // Find the selected category by slug or ID
  const selectedCategory = categories.find(cat => 
    String(cat.slug) === String(categoryParam) || String(cat.id) === String(categoryParam)
  );

  if (selectedCategory) {
    initialCategoryValue = selectedCategory.slug || selectedCategory.id;
  } else if (categoryParam && categoryParam !== 'all') {
    initialCategoryValue = categoryParam;
  }

  // Perform SSR Filtering & Pre-Decode Entities
  posts = allPosts.filter(post => {
    let match = true;
    if (search) {
      const s = search.toLowerCase();
      match = match && ((post.title || '').toLowerCase().includes(s) || (post.excerpt || '').toLowerCase().includes(s));
    }
    if (categoryParam && categoryParam !== 'all') {
      if (selectedCategory) {
        match = match && String(post.category_id) === String(selectedCategory.id);
      } else {
        // Fallback: direct ID matching
        match = match && String(post.category_id) === String(categoryParam);
      }
    }
    return match;
  }).map(post => ({
    ...post,
    title: decodeHtmlEntities(post.title || ''),
    excerpt: decodeHtmlEntities(post.excerpt || ''),
    category_name: decodeHtmlEntities(post.category_name || post.category || ''),
    author_name: decodeHtmlEntities(post.author_name || '')
  }));

  // Deduplicate by slug in case of double-save bugs in Firestore
  const uniquePosts = [];
  const seenSlugs = new Set();
  for (const p of posts) {
    if (!seenSlugs.has(p.slug)) {
      seenSlugs.add(p.slug);
      uniquePosts.push(p);
    }
  }
  posts = uniquePosts;

} catch (e) {
  console.error('[Blog List] Firestore fetch failed:', e.message);
  error = e.message;
}

const featuredPost = posts.find(p => p.is_featured);
// Remove featured post from the list if it's the first page and no filters are applied
let listPosts = posts;
if (featuredPost && !search && !categoryParam && pageParam === 1) {
  listPosts = posts.filter(p => p.id !== featuredPost.id);
}

const totalPages = Math.ceil(listPosts.length / ITEMS_PER_PAGE);
const currentPage = Math.max(1, Math.min(pageParam, totalPages || 1));
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const paginatedPosts = listPosts.slice(startIndex, startIndex + ITEMS_PER_PAGE);

function getExcerpt(post) {
  if (post.excerpt) return post.excerpt;
  if (post.content_html) return stripHtml(post.content_html).substring(0, 160) + '...';
  return '';
}

function getReadingTime(post) {
  const content = post.content || post.content_html || '';
  return Math.ceil(stripHtml(content).split(/\s+/).length / 200) || 1;
}
---

<PublicLayout
  title="Insights & Stories | Entrepreneur BD Blog"
  description="Discover inspiring stories, expert insights, and practical guides from Bangladesh's entrepreneur community."
>
  <!-- Header -->
  <div class="bg-emerald-900 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Badge className="bg-emerald-800 text-emerald-100 mb-4 hover:bg-emerald-800">Blog</Badge>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Insights & Stories
      </h1>
      <p class="text-lg text-emerald-100 max-w-2xl">
        Discover inspiring stories, expert insights, and practical guides from Bangladesh's entrepreneur community.
      </p>
    </div>
  </div>

  <!-- Filters -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <BlogFilters 
      client:load 
      initialSearch={search} 
      initialCategory={initialCategoryValue} 
      categories={categories} 
    />
  </div>

  <!-- Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {error ? (
      <div class="text-center py-16">
        <p class="text-lg text-stone-500">Unable to load posts at this time.</p>
      </div>
    ) : posts.length === 0 ? (
      <div class="text-center py-16">
        <p class="text-lg text-stone-500">No articles found</p>
        {(search || categoryParam) && (
          <a href="/blog" class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 mt-4">
            Clear Filters
          </a>
        )}
      </div>
    ) : (
      <>
        {/* Featured Post (Only show on page 1 with no filters) */}
        {featuredPost && !search && !categoryParam && currentPage === 1 && (
          <a href={`/blog/${featuredPost.slug}`} class="block mb-12">
            <Card className="overflow-hidden border-stone-200 hover:border-emerald-900/20 hover:shadow-xl transition-all duration-300">
              <div class="grid lg:grid-cols-2">
                <div class="aspect-video lg:aspect-auto bg-stone-100 overflow-hidden">
                  {featuredPost.featured_image ? (
                    <img
                      src={featuredPost.featured_image}
                      alt={featuredPost.title}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <BrandedPlaceholder 
                      title={featuredPost.title} 
                      category={featuredPost.category_name || featuredPost.category} 
                    />
                  )}
                </div>
                <CardContent className="p-8 lg:p-12 flex flex-col justify-center">
                  <Badge className="bg-red-100 text-red-700 hover:bg-red-100 w-fit mb-4">Featured</Badge>
                  <h2 class="text-2xl lg:text-3xl font-bold text-stone-900 mb-4">
                    {featuredPost.title}
                  </h2>
                  <p class="text-stone-600 mb-6 line-clamp-3">{getExcerpt(featuredPost)}</p>
                  
                  <div class="flex items-center gap-6 text-sm text-stone-500">
                    <span class="flex items-center gap-2">
                      <User className="w-4 h-4" />
                      {featuredPost.author_name || 'Entrepreneurs BD'}
                    </span>
                    <span class="flex items-center gap-2 ml-4">
                      <Clock className="w-4 h-4" />
                      {getReadingTime(featuredPost)} min read
                    </span>
                  </div>
                </CardContent>
              </div>
            </Card>
          </a>
        )}

        {/* Posts Grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {paginatedPosts.map((post) => (
            <a href={`/blog/${post.slug}`}>
              <Card className="h-full overflow-hidden border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
                <div class="aspect-[3/2] bg-stone-100 overflow-hidden">
                  {post.featured_image ? (
                    <img
                      src={post.featured_image}
                      alt={post.title}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <BrandedPlaceholder 
                      title={post.title} 
                      category={post.category_name || post.category} 
                    />
                  )}
                </div>
                <CardContent className="p-6">
                  {(post.category_name || post.category) && (
                    <Badge variant="outline" className="mb-3 text-sm">
                      {post.category_name || post.category}
                    </Badge>
                  )}
                  <h2 class="font-semibold text-stone-900 mb-2 line-clamp-2 group-hover:text-emerald-900">
                    {post.title}
                  </h2>
                  <p class="text-sm text-stone-600 line-clamp-2 mb-4">{getExcerpt(post)}</p>
                  
                  <div class="flex items-center justify-between text-sm text-stone-500">
                    <span class="flex items-center gap-1">
                      <User className="w-3 h-3" />
                      {post.author_name || 'Entrepreneurs BD'}
                    </span>
                    <span class="flex items-center gap-1">
                      <Clock className="w-3 h-3" />
                      {getReadingTime(post)} min read
                    </span>
                  </div>
                </CardContent>
              </Card>
            </a>
          ))}
        </div>
        
        {totalPages > 1 && (
          <div class="mt-16 border-t border-stone-200 pt-8">
            <SitePagination 
              client:load 
              currentPage={currentPage} 
              totalPages={totalPages} 
            />
          </div>
        )}
      </>
    )}
  </div>
</PublicLayout>
