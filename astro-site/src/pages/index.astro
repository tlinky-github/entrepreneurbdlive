---
// Homepage — SSR with data fetched from Firestore
import PublicLayout from '../layouts/PublicLayout.astro';
import { getRecentPosts, getPublishedDocs } from '../lib/api';

let recentPosts = [];
let featuredEntrepreneurs = [];

try {
  recentPosts = await getRecentPosts(6);
} catch (e) { console.error('[Home] Posts fetch failed:', e.message); }

try {
  featuredEntrepreneurs = await getPublishedDocs('profiles', 6);
} catch (e) { console.error('[Home] Profiles fetch failed:', e.message); }
---

<PublicLayout
  title="Entrepreneur BD | Empowering Bangladesh's Startup Ecosystem"
  description="Bangladesh's premier growth hub for startups and visionaries. Connect, discover, and scale your business within our national entrepreneurship ecosystem."
>
  <!-- Hero Section -->
  <section class="relative py-24 lg:py-32 bg-gradient-to-br from-stone-900 via-emerald-950 to-stone-900 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 50%, rgba(16,185,129,0.3) 0%, transparent 50%), radial-gradient(circle at 75% 50%, rgba(6,78,59,0.3) 0%, transparent 50%);"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 mb-8">
          <div class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></div>
          <span class="text-sm font-medium text-emerald-300">Bangladesh's Startup Ecosystem</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          Empowering the Next Generation of
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-emerald-300"> Entrepreneurs</span>
        </h1>
        <p class="text-lg text-stone-300 mb-10 max-w-2xl">
          Connect with founders, discover businesses, and access the resources you need to build and scale your venture in Bangladesh.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/entrepreneurs" class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white rounded-lg font-semibold hover:bg-emerald-500 transition-colors">
            Explore Entrepreneurs
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/submit" class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-white rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Get Listed
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Blog Posts -->
  {recentPosts.length > 0 && (
    <section class="py-20 lg:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-12">
          <div>
            <h2 class="text-3xl font-bold text-stone-900 mb-2">Latest Insights</h2>
            <p class="text-stone-600">Stories, guides, and analysis from the ecosystem</p>
          </div>
          <a href="/blog" class="hidden sm:inline-flex items-center gap-2 text-emerald-900 font-medium hover:text-emerald-700 transition-colors">
            View all
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group block bg-white rounded-xl border border-stone-200 overflow-hidden hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
              {post.featured_image && (
                <div class="aspect-video overflow-hidden">
                  <img src={post.featured_image} alt={post.title || ''} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
              )}
              <div class="p-6">
                {post.category && (
                  <span class="inline-block px-3 py-1 text-xs font-semibold text-emerald-900 bg-emerald-50 rounded-full mb-3">{post.category}</span>
                )}
                <h3 class="text-lg font-bold text-stone-900 mb-2 group-hover:text-emerald-900 transition-colors line-clamp-2">{post.title}</h3>
                <p class="text-sm text-stone-600 line-clamp-2">{post.excerpt || ''}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Featured Entrepreneurs -->
  {featuredEntrepreneurs.length > 0 && (
    <section class="py-20 lg:py-24 bg-stone-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-12">
          <div>
            <h2 class="text-3xl font-bold text-stone-900 mb-2">Featured Entrepreneurs</h2>
            <p class="text-stone-600">Meet the founders shaping Bangladesh's future</p>
          </div>
          <a href="/entrepreneurs" class="hidden sm:inline-flex items-center gap-2 text-emerald-900 font-medium hover:text-emerald-700 transition-colors">
            View all
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredEntrepreneurs.map((profile) => (
            <a href={`/entrepreneurs/${profile.slug}`} class="group block bg-white rounded-xl border border-stone-200 overflow-hidden hover:shadow-lg transition-all duration-300 hover:-translate-y-1 p-6">
              <div class="flex items-center gap-4 mb-4">
                {profile.photo ? (
                  <img src={profile.photo} alt={profile.name || ''} class="w-16 h-16 rounded-full object-cover" loading="lazy" />
                ) : (
                  <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center">
                    <span class="text-emerald-900 font-bold text-xl">{(profile.name || 'E').charAt(0)}</span>
                  </div>
                )}
                <div>
                  <h3 class="font-bold text-stone-900 group-hover:text-emerald-900 transition-colors">{profile.name}</h3>
                  {profile.title && <p class="text-sm text-stone-500">{profile.title}</p>}
                </div>
              </div>
              {profile.short_bio && (
                <p class="text-sm text-stone-600 line-clamp-3">{profile.short_bio}</p>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="py-20 lg:py-24 bg-emerald-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6">
        Ready to Share Your Story?
      </h2>
      <p class="text-lg text-emerald-100 mb-10 max-w-2xl mx-auto">
        Whether you're a founder, a growing business, or a service provider — get listed on Bangladesh's premier entrepreneurship platform.
      </p>
      <a href="/submit" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-emerald-900 rounded-lg font-bold text-lg hover:bg-emerald-50 transition-colors">
        Apply to Get Listed
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</PublicLayout>
