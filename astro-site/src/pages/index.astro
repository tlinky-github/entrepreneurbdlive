---
import PublicLayout from '../layouts/PublicLayout.astro';
import { getRecentPosts, getFeaturedDocs, getPublicStats, taxonomyAPI, getSiteSettings } from '../lib/serverApi';
import { getWebSiteSchema, getOrganizationSchema } from '../lib/schema';
import { resolveListingTypeLabel } from '../lib/listingTypes.js';
import { Badge } from '../components/ui/badge.jsx';
import { Button } from '../components/ui/button.jsx';
import { Card, CardContent } from '../components/ui/card.jsx';
import BrandedPlaceholder from '../components/blog/BrandedPlaceholder.jsx';
import {
  Users, Building2, FileText, BookOpen, Rocket, Target, TrendingUp,
  Star, MapPin, ChevronRight, Lightbulb, User, Clock, ArrowRight
} from 'lucide-react';

let featuredPosts = [];
let featuredEntrepreneurs = [];
let featuredListings = [];
let listingTypes = [];
let knowledgeItems = [];
let stats = {};
let siteSettings = null;

try {
  siteSettings = await getSiteSettings();
} catch (e) { console.error('[Home] Settings fetch failed:', e.message); }

try {
  // Fetch featured posts, limit 3. If none, fallback to recent 3
  featuredPosts = await getFeaturedDocs('posts', 3);
  if (featuredPosts.length === 0) {
    featuredPosts = await getRecentPosts(3);
  }
} catch (e) { console.error('[Home] Posts fetch failed:', e.message); }

try {
  featuredEntrepreneurs = await getFeaturedDocs('profiles', 4);
} catch (e) { console.error('[Home] Profiles fetch failed:', e.message); }

try {
  featuredListings = await getFeaturedDocs('listings', 4);
} catch (e) { console.error('[Home] Listings fetch failed:', e.message); }

try {
  listingTypes = await taxonomyAPI.getByCollection('listing_types');
} catch (e) { console.error('[Home] Listing types fetch failed:', e.message); }

try {
  knowledgeItems = await getRecentPosts(6); // Wait, resource API list
  // Note: Assuming 'resources' collection exists, we fallback to it. But we don't have getRecentResources.
  const resDocs = await getFeaturedDocs('resources', 6);
  if (resDocs.length === 0) {
     const { getPublishedDocs } = await import('../lib/serverApi');
     const allRes = await getPublishedDocs('resources', 6);
     knowledgeItems = allRes;
  } else {
     knowledgeItems = resDocs;
  }
} catch (e) { console.error('[Home] Resources fetch failed:', e.message); }

try {
  stats = await getPublicStats();
} catch (e) { console.error('[Home] Stats fetch failed:', e.message); }

const iconMap = {
  Lightbulb: Lightbulb,
  MapPin: MapPin,
  Users: Users,
  Building: Building2,
  TrendingUp: TrendingUp,
  Rocket: Rocket,
};
const pageSchema = [getWebSiteSchema(), getOrganizationSchema()];

const siteTitle = siteSettings?.seo_title || siteSettings?.site_name 
  ? `${siteSettings.site_name}${siteSettings.site_tagline ? ` - ${siteSettings.site_tagline}` : ''}`
  : "Entrepreneur BD - Bangladesh Entrepreneur Ecosystem";

const siteDescription = siteSettings?.seo_description || "Connect with entrepreneurs, discover startups, and access resources for business growth in Bangladesh.";
---

<PublicLayout 
  title={siteTitle}
  description={siteDescription}
  schema={pageSchema}
>
  <div class="bg-stone-50" data-testid="home-page">
    {/* Hero Section */}
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-emerald-900"></div>
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="animate-fade-in">
            <Badge className="bg-emerald-800 text-emerald-100 mb-6 px-4 py-1.5 border-emerald-700">
              Bangladesh's Entrepreneur Ecosystem
            </Badge>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
              Empowering <span class="text-[#ef4337]">Entrepreneurs</span> to Build the Future
            </h1>
            <p class="text-lg text-emerald-100 mb-8 max-w-lg">
              Connect with Bangladesh's most ambitious founders, discover thriving startups,
              and access resources to fuel your entrepreneurial journey.
            </p>
            <div class="flex flex-wrap gap-4">
              <a href="/submit">
                <Button size="lg" className="bg-white text-emerald-900 hover:bg-stone-100 px-8 font-bold shadow-lg">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 w-5 h-5"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                  Get Listed
                </Button>
              </a>
              <a href="/directory">
                <Button size="lg" variant="outline" className="bg-transparent border-white text-white hover:bg-white/10 px-8">
                  Explore Directory
                </Button>
              </a>
            </div>
          </div>

          <div class="hidden lg:block animate-slide-up">
            <img
              src="https://images.unsplash.com/photo-1627599936744-51d288f89af4?w=600&h=400&fit=crop"
              alt="Bangladeshi entrepreneurs collaborating"
              decoding="async"
              class="rounded-2xl shadow-2xl"
            />
          </div>
        </div>
      </div>
    </section>

    {/* Stats Section */}
    <section class="relative -mt-12 z-10">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-xl p-8 grid grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-12 h-12 bg-emerald-100 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <Users className="w-6 h-6 text-emerald-900" />
            </div>
            <div class="text-3xl font-bold text-stone-900">{stats.total_entrepreneurs || 0}+</div>
            <div class="text-sm text-stone-500">Entrepreneurs</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-emerald-100 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <Building2 className="w-6 h-6 text-emerald-900" />
            </div>
            <div class="text-3xl font-bold text-stone-900">{stats.total_listings || 0}+</div>
            <div class="text-sm text-stone-500">Businesses</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-emerald-100 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <FileText className="w-6 h-6 text-emerald-900" />
            </div>
            <div class="text-3xl font-bold text-stone-900">{stats.total_blog_posts || 0}+</div>
            <div class="text-sm text-stone-500">Articles</div>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-emerald-100 rounded-xl mx-auto mb-3 flex items-center justify-center">
              <BookOpen className="w-6 h-6 text-emerald-900" />
            </div>
            <div class="text-3xl font-bold text-stone-900">{stats.total_resources || 0}+</div>
            <div class="text-sm text-stone-500">Resources</div>
          </div>
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="py-20 lg:py-28">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <Badge className="bg-emerald-100 text-emerald-900 mb-4 border-emerald-200 hover:bg-emerald-200">Platform Features</Badge>
          <h2 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-4">
            Everything You Need to Grow
          </h2>
          <p class="text-lg text-stone-600 max-w-2xl mx-auto">
            From building your profile to finding resources, we've got the tools to support your entrepreneurial journey.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <Card className="border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
            <CardContent className="p-8">
              <div class="w-14 h-14 bg-emerald-100 rounded-2xl mb-6 flex items-center justify-center group-hover:bg-emerald-900 transition-colors">
                <Rocket className="w-7 h-7 text-emerald-900 group-hover:text-white transition-colors" />
              </div>
              <h3 class="text-xl font-semibold text-stone-900 mb-3">Entrepreneur Profiles</h3>
              <p class="text-stone-600">Showcase your journey and connect with fellow founders across Bangladesh.</p>
            </CardContent>
          </Card>
          <Card className="border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
            <CardContent className="p-8">
              <div class="w-14 h-14 bg-emerald-100 rounded-2xl mb-6 flex items-center justify-center group-hover:bg-emerald-900 transition-colors">
                <Target className="w-7 h-7 text-emerald-900 group-hover:text-white transition-colors" />
              </div>
              <h3 class="text-xl font-semibold text-stone-900 mb-3">Business Directory</h3>
              <p class="text-stone-600">List your startup or SME and get discovered by investors and partners.</p>
            </CardContent>
          </Card>
          <Card className="border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
            <CardContent className="p-8">
              <div class="w-14 h-14 bg-emerald-100 rounded-2xl mb-6 flex items-center justify-center group-hover:bg-emerald-900 transition-colors">
                <TrendingUp className="w-7 h-7 text-emerald-900 group-hover:text-white transition-colors" />
              </div>
              <h3 class="text-xl font-semibold text-stone-900 mb-3">Growth Resources</h3>
              <p class="text-stone-600">Access guides, templates, and tools to accelerate your business growth.</p>
            </CardContent>
          </Card>
        </div>
      </div>
    </section>

    {/* Resources / Knowledge Hub Section */}
    {knowledgeItems.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-end mb-12">
            <div>
              <Badge className="bg-emerald-100 text-emerald-900 mb-4 border-emerald-200 hover:bg-emerald-200">Resources for Entrepreneurs</Badge>
              <h2 class="text-3xl font-bold text-stone-900 mb-4">Everything you need to start, grow, and scale</h2>
              <p class="text-lg text-stone-600 max-w-2xl">Comprehensive guides and insights to help you build your business successfully.</p>
            </div>
            <a href="/knowledge" class="hidden sm:flex items-center gap-2 text-emerald-900 hover:text-emerald-700 font-medium">
              View All Topics <ChevronRight className="w-5 h-5" />
            </a>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {knowledgeItems.map((item) => {
              const IconComponent = BookOpen;
              return (
                <a href={`/knowledge/${item.id}`} class="block">
                  <Card className="h-full border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
                    <CardContent className="p-8 flex flex-col h-full">
                      <div class="w-12 h-12 bg-emerald-50 rounded-2xl mb-6 flex items-center justify-center group-hover:bg-emerald-900 transition-colors">
                        <IconComponent className="w-6 h-6 text-emerald-900 group-hover:text-white transition-colors" />
                      </div>
                      <h3 class="text-xl font-semibold text-stone-900 mb-2 group-hover:text-emerald-900 transition-colors">
                        {item.title}
                      </h3>
                      <p class="text-sm font-medium text-emerald-800 mb-3">
                        {item.subtitle || ''}
                      </p>
                      <p class="text-stone-600 mb-6 flex-1 line-clamp-3">
                        {item.description || item.excerpt || ''}
                      </p>
                      <div class="flex items-center text-emerald-900 font-medium text-sm mt-auto group-hover:translate-x-1 transition-transform">
                        Read Article <ArrowRight className="ml-2 w-4 h-4" />
                      </div>
                    </CardContent>
                  </Card>
                </a>
              );
            })}
          </div>
          
          <div class="sm:hidden mt-8 text-center">
            <a href="/knowledge">
              <Button variant="outline" className="border-emerald-900 text-emerald-900">
                View All Topics <ChevronRight className="w-4 h-4 ml-2" />
              </Button>
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Featured Entrepreneurs */}
    {featuredEntrepreneurs.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-end mb-12">
            <div>
              <Badge className="bg-red-100 text-red-700 mb-4 border-red-200 hover:bg-red-200">Featured</Badge>
              <h2 class="text-3xl font-bold text-stone-900">Meet Our Entrepreneurs</h2>
            </div>
            <a href="/entrepreneurs" class="hidden sm:flex items-center gap-2 text-emerald-900 hover:text-emerald-700 font-medium">
              View All <ChevronRight className="w-5 h-5" />
            </a>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {featuredEntrepreneurs.map((entrepreneur) => (
              <a href={`/entrepreneurs/${entrepreneur.slug}`} class="block h-full">
                <Card className="border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 h-full">
                  <CardContent className="p-6">
                    <div class="w-20 h-20 bg-emerald-100 rounded-full mx-auto mb-4 flex items-center justify-center overflow-hidden">
                      {entrepreneur.photo ? (
                        <img 
                          src={entrepreneur.photo} 
                          alt={entrepreneur.name} 
                          loading="lazy"
                          class="w-full h-full object-cover" 
                        />
                      ) : (
                        <span class="text-2xl font-bold text-emerald-900">
                          {(entrepreneur.name || 'E').charAt(0).toUpperCase()}
                        </span>
                      )}
                    </div>
                    <div class="text-center">
                      <h3 class="font-semibold text-stone-900">{entrepreneur.name}</h3>
                      {entrepreneur.role_title && entrepreneur.company_name && (
                        <p class="text-sm text-stone-500 mt-1">
                          {entrepreneur.role_title} at {entrepreneur.company_name}
                        </p>
                      )}
                      {entrepreneur.industry && (
                        <Badge variant="outline" className="mt-3 text-sm">
                          {entrepreneur.industry}
                        </Badge>
                      )}
                    </div>
                  </CardContent>
                </Card>
              </a>
            ))}
          </div>
          
          <div class="sm:hidden mt-8 text-center">
            <a href="/entrepreneurs">
              <Button variant="outline" className="border-emerald-900 text-emerald-900">
                View All Entrepreneurs <ChevronRight className="w-4 h-4 ml-2" />
              </Button>
            </a>
          </div>
        </div>
      </section>
    )}

    {/* Featured Directory */}
    {featuredListings.length > 0 && (
      <section class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-end mb-12">
            <div>
              <Badge className="bg-emerald-100 text-emerald-900 mb-4 border-emerald-200 hover:bg-emerald-200">Directory</Badge>
              <h2 class="text-3xl font-bold text-stone-900">Featured Businesses</h2>
            </div>
            <a href="/directory" class="hidden sm:flex items-center gap-2 text-emerald-900 hover:text-emerald-700 font-medium">
              View All <ChevronRight className="w-5 h-5" />
            </a>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {featuredListings.map((listing) => (
              <a href={`/directory/${listing.slug}`} class="block h-full">
                <Card className="border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 h-full">
                  <CardContent className="p-6">
                    <div class="flex items-start gap-4">
                      <div class="w-14 h-14 bg-stone-100 rounded-2xl flex items-center justify-center flex-shrink-0 overflow-hidden">
                        {listing.logo ? (
                          <img 
                            src={listing.logo} 
                            alt={listing.business_name} 
                            loading="lazy"
                            class="w-full h-full object-cover" 
                          />
                        ) : (
                          <Building2 className="w-6 h-6 text-stone-400" />
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                          <h3 class="font-semibold text-stone-900 truncate">{listing.business_name}</h3>
                          {listing.is_verified && (
                            <Star className="w-4 h-4 text-yellow-500 fill-yellow-500 flex-shrink-0" />
                          )}
                        </div>
                        <p class="text-sm text-stone-500 capitalize">
                          {resolveListingTypeLabel(listing.listing_type, listing.listing_type_name, listingTypes) || listing.industry || 'Business'}
                        </p>
                        {listing.city && (
                          <p class="text-sm text-stone-400 mt-1 flex items-center gap-1">
                            <MapPin className="w-3 h-3" />
                            {listing.city}
                          </p>
                        )}
                      </div>
                    </div>
                    {listing.short_description && (
                      <p class="text-sm text-stone-600 mt-4 line-clamp-2">
                        {listing.short_description}
                      </p>
                    )}
                  </CardContent>
                </Card>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Latest Blog Posts */}
    {featuredPosts.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-end mb-12">
            <div>
              <Badge className="bg-emerald-100 text-emerald-900 mb-4 border-emerald-200 hover:bg-emerald-200">Blog</Badge>
              <h2 class="text-3xl font-bold text-stone-900">Latest Insights</h2>
            </div>
            <a href="/blog" class="hidden sm:flex items-center gap-2 text-emerald-900 hover:text-emerald-700 font-medium">
              View All <ChevronRight className="w-5 h-5" />
            </a>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            {featuredPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="block">
                <Card className="h-full overflow-hidden border-stone-200 hover:border-emerald-900/20 hover:shadow-lg transition-all duration-200 group">
                  <div class="aspect-[3/2] bg-stone-100 overflow-hidden">
                    {post.featured_image ? (
                      <img
                        src={post.featured_image}
                        alt={post.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        loading="lazy"
                      />
                    ) : (
                      <BrandedPlaceholder 
                        title={post.title} 
                        category={post.category_name || post.category} 
                      />
                    )}
                  </div>
                  <CardContent className="p-6">
                    {post.category_name && (
                      <Badge variant="outline" className="mb-3 text-sm">
                        {post.category_name}
                      </Badge>
                    )}
                    <h2 class="font-semibold text-stone-900 mb-2 line-clamp-2 group-hover:text-emerald-900 transition-colors">
                      {post.title}
                    </h2>
                    {post.excerpt && (
                      <p class="text-sm text-stone-600 line-clamp-2 mb-4">{post.excerpt}</p>
                    )}
                    <div class="flex items-center justify-between text-sm text-stone-500">
                      <span class="flex items-center gap-1">
                        <User className="w-3 h-3" />
                        {post.author_name || 'Entrepreneurs BD'}
                      </span>
                      {(post.content || post.content_html) && (
                        <span class="flex items-center gap-1">
                          <Clock className="w-3 h-3" />
                          {Math.ceil(((post.content || post.content_html).replace(/<[^>]+>/g, '').split(/\s+/).length) / 200)} min read
                        </span>
                      )}
                    </div>
                  </CardContent>
                </Card>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* Big Call to Action Section */}
    <section class="py-20 bg-emerald-900 relative overflow-hidden">
      <div class="absolute inset-0 opacity-5">
         <div class="absolute inset-0" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 35c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57 43c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM16 38c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5z' fill='%23ffffff' fill-opacity='1' fill-rule='evenodd'/%3E%3C/svg%3E&quot;);"></div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <Badge className="bg-emerald-800 text-emerald-100 mb-6 px-4 py-1.5 uppercase tracking-wider text-[10px] font-bold border-emerald-700 hover:bg-emerald-800">
          Accelerate Your Growth
        </Badge>
        <h2 class="text-3xl sm:text-5xl font-bold text-white mb-8">
          Ready to spotlight your <span class="text-emerald-400">journey</span>?
        </h2>
        <p class="text-xl text-emerald-100/80 mb-10 max-w-3xl mx-auto leading-relaxed">
          Join thousands of Bangladeshi entrepreneurs. Showcase your profile, list your business, 
          and get discovered by the stakeholders who matter most.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/submit">
            <Button size="lg" className="bg-white text-emerald-900 hover:bg-stone-100 px-10 h-14 rounded-xl font-bold text-lg shadow-2xl transition-transform hover:scale-105">
              Apply for Feature
            </Button>
          </a>
          <a href="/directory">
