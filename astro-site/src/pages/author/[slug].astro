---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { authorAPI, postAPI, profileAPI, listingAPI, resourceAPI } from '../../lib/serverApi';
import { decodeHtmlEntities } from '../../lib/smartDesign';
import { Card, CardContent } from '../../components/ui/card.jsx';
import { Badge } from '../../components/ui/badge.jsx';
import { 
  Globe, 
  Linkedin, 
  Twitter, 
  Facebook, 
  Calendar,
  ChevronRight,
  TrendingUp,
  FileText,
  Users,
  Building2,
  BookOpen,
  Clock
} from 'lucide-react';

const { slug } = Astro.params;

// Fetch author from database
let author: any = null;
try {
  author = await authorAPI.getBySlug(slug as string);
  if (author) {
    author = {
      ...author,
      name: decodeHtmlEntities(author.name || ''),
      bio: decodeHtmlEntities(author.bio || ''),
      designation: decodeHtmlEntities(author.designation || '')
    };
  }
} catch (error) {
  console.error('Error loading author:', error);
}

if (!author) {
  return new Response('Author not found', { status: 404 });
}

// Fetch all contributions on the server side
let contents: any[] = [];
try {
  const [posts, profiles, listings, resources] = await Promise.all([
    postAPI.list(),
    profileAPI.list(),
    listingAPI.list(),
    resourceAPI.list()
  ]);

  contents = [
    ...(posts || []).map((p: any) => ({ ...p, type: 'blog', link: `/blog/${p.slug}`, icon: FileText })),
    ...(profiles || []).map((p: any) => ({ ...p, type: 'entrepreneur', link: `/entrepreneurs/${p.slug}`, icon: Users, title: p.name })),
    ...(listings || []).map((l: any) => ({ ...l, type: 'directory', link: `/directory/${l.slug}`, icon: Building2, title: l.business_name })),
    ...(resources || []).map((r: any) => ({ ...r, type: 'knowledge', link: `/knowledge/${r.slug}`, icon: BookOpen }))
  ].filter((item: any) => item.authorId === author.id)
   .map((item: any) => ({
     ...item,
     title: decodeHtmlEntities(item.title || ''),
     excerpt: decodeHtmlEntities(item.excerpt || item.details || item.short_description || '')
   }));

  // Sort by created_at desc
  contents.sort((a, b) => {
    const dateA = a.created_at ? new Date(a.created_at).getTime() : 0;
    const dateB = b.created_at ? new Date(b.created_at).getTime() : 0;
    return dateB - dateA;
  });
} catch (error) {
  console.error('Error loading author contents:', error);
}

function ensureAbsoluteUrl(url: string) {
  if (!url) return '';
  if (!/^https?:\/\//i.test(url)) {
    return `https://${url}`;
  }
  return url;
}

function getReadingTime(item: any) {
  const text = item.content || item.content_html || '';
  const wordCount = text.replace(/<[^>]+>/g, '').split(/\s+/).length || 0;
  return Math.ceil(wordCount / 200) || 1;
}

const title = `${author.name} | Author Profile`;
const description = author.bio?.substring(0, 160) || `Read articles and contributions from ${author.name} on Entrepreneurs BD.`;
const image = author.photo || '/og-default.png';
---

<PublicLayout 
  title={title}
  description={description}
  image={image}
  type="profile"
>
  <div class="min-h-screen bg-stone-50 pt-24 pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header Section -->
      <div class="relative mb-12">
        <!-- Cover Background -->
        <div class="h-48 md:h-64 w-full bg-stone-900 rounded-3xl overflow-hidden relative shadow-inner">
          {author.cover_image ? (
            <img src={author.cover_image} class="w-full h-full object-cover" alt="" />
          ) : (
            <div class="w-full h-full relative">
              <div class="absolute inset-0 bg-gradient-to-br from-emerald-950 via-emerald-900/60 to-stone-950 opacity-90" />
              <div class="absolute inset-0 opacity-10" style={{ backgroundImage: `url("https://www.transparenttextures.com/patterns/carbon-fibre.png")` }} />
            </div>
          )}
          <div class="absolute inset-0 bg-black/10" />
        </div>
        
        <!-- Profile Basic Info -->
        <div class="absolute -bottom-12 md:-bottom-10 left-4 md:left-8 flex flex-col md:flex-row items-center md:items-end gap-4 md:gap-6 w-[calc(100%-2rem)] md:w-full pr-0 md:pr-16">
          <div class="w-28 h-28 md:w-40 md:h-40 rounded-full border-4 border-white overflow-hidden bg-stone-100 shadow-xl flex-shrink-0">
            {author.photo ? (
              <img src={author.photo} alt={author.name} class="w-full h-full object-cover" />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-4xl text-stone-400 font-bold bg-stone-50">
                {author.name?.charAt(0) || 'A'}
              </div>
            )}
          </div>
          <div class="pb-4 pt-2 md:pt-0 text-center md:text-left">
            <h1 class="text-2xl md:text-4xl font-bold text-white drop-shadow-lg">{author.name}</h1>
            <div class="flex flex-wrap items-center gap-4 mt-2">
              <Badge className="bg-emerald-100 text-emerald-900 hover:bg-emerald-100 border-none px-3">
                {author.designation || 'Official Author'}
              </Badge>
              {contents.length > 0 && (
                 <span class="text-sm text-stone-500 font-medium flex items-center gap-1">
                    <TrendingUp className="w-4 h-4" />
                    {contents.length} Contributions
                 </span>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-4 gap-8 mt-16 md:mt-24">
        <!-- Sidebar -->
        <div class="space-y-6">
          <Card className="border-stone-200">
            <CardContent className="p-6">
              <h3 class="text-sm font-bold text-stone-900 uppercase tracking-wider mb-4">About Author</h3>
              <p class="text-stone-600 leading-relaxed text-sm">
                {author.bio || "Professional contributor to Entrepreneurs BD, focusing on the growth and development of the Bangladeshi startup ecosystem."}
              </p>

              <div class="mt-8 space-y-4 pt-6 border-t border-stone-100">
                <h3 class="text-sm font-bold text-stone-400 uppercase tracking-widest">Connect</h3>
                <div class="flex flex-col gap-3">
                  {author.website && (
                    <a 
                      href={ensureAbsoluteUrl(author.website)} 
                      target={author.website_link_settings?.target || "_blank"} 
                      rel={author.website_link_settings?.rel || "noopener noreferrer"} 
                      class="text-stone-600 hover:text-emerald-900 text-sm flex items-center gap-2 transition-colors"
                    >
                      <Globe className="w-4 h-4" /> Website
                    </a>
                  )}
                  {author.linkedin && (
                    <a href={ensureAbsoluteUrl(author.linkedin)} target="_blank" rel="noopener noreferrer nofollow" class="text-stone-600 hover:text-blue-700 text-sm flex items-center gap-2 transition-colors">
                      <Linkedin className="w-4 h-4" /> LinkedIn
                    </a>
                  )}
                  {author.twitter && (
                    <a href={ensureAbsoluteUrl(author.twitter)} target="_blank" rel="noopener noreferrer nofollow" class="text-stone-600 hover:text-sky-500 text-sm flex items-center gap-2 transition-colors">
                      <Twitter className="w-4 h-4" /> Twitter
                    </a>
                  )}
                  {author.facebook && (
                    <a href={ensureAbsoluteUrl(author.facebook)} target="_blank" rel="noopener noreferrer nofollow" class="text-stone-600 hover:text-blue-600 text-sm flex items-center gap-2 transition-colors">
                      <Facebook className="w-4 h-4" /> Facebook
                    </a>
                  )}
                  {!author.website && !author.linkedin && !author.twitter && !author.facebook && (
                    <p class="text-sm text-stone-400 italic">No social links provided.</p>
                  )}
                </div>
              </div>
            </CardContent>
          </Card>
        </div>

        <!-- Main Content Area -->
        <div class="lg:col-span-3">
          <div class="mb-6 flex items-center justify-between">
            <h2 class="text-xl font-bold text-stone-900">Articles & Contributions</h2>
            <div class="h-px flex-1 bg-stone-200 mx-6 hidden md:block" />
          </div>

          <div class="space-y-4">
            {contents.length === 0 ? (
              <Card className="border-dashed border-stone-300 bg-transparent py-16">
                <div class="text-center px-6">
                  <FileText className="w-12 h-12 text-stone-200 mx-auto mb-4" />
                  <p class="text-stone-500">This author hasn't published any articles yet.</p>
                </div>
              </Card>
            ) : (
              contents.map((item) => {
                const IconComponent = item.icon;
                return (
                  <a href={item.link} class="block mb-4">
                    <Card className="border-stone-200 hover:border-emerald-500/30 hover:shadow-xl hover:shadow-emerald-900/5 transition-all duration-300 group overflow-hidden">
                      <CardContent className="p-0">
                        <div class="flex flex-col md:flex-row">
                          {item.featured_image && (
                            <div class="w-full md:w-32 h-40 md:h-auto flex-shrink-0 bg-stone-100 overflow-hidden">
                              <img src={item.featured_image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                            </div>
                          )}
                          <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                              <div class="flex items-center gap-2 mb-2">
                                <IconComponent className="w-3.5 h-3.5 text-stone-400" />
                                <span class="text-[10px] uppercase tracking-widest text-stone-400 font-bold">{item.type}</span>
                                <div class="w-1 h-1 rounded-full bg-stone-300" />
                                <span class="text-[10px] text-stone-400 flex items-center gap-1">
                                  <Calendar className="w-3 h-3" />
                                  {item.created_at
                                    ? new Date(item.created_at).toLocaleDateString()
                                    : 'Recently'}
                                </span>
                                {(item.content || item.content_html) && (
                                  <>
                                    <div class="w-1 h-1 rounded-full bg-stone-300 mx-1" />
                                    <span class="text-[10px] text-stone-400 flex items-center gap-1">
                                      <Clock className="w-3 h-3" />
                                      {getReadingTime(item)} min read
                                    </span>
                                  </>
                                )}
                              </div>
                              <h3 class="text-lg font-bold text-stone-900 group-hover:text-emerald-900 transition-colors line-clamp-1">{item.title}</h3>
                              <p class="text-sm text-stone-500 line-clamp-2 mt-2">
                                {item.excerpt || item.details || item.short_description || (item.content ? item.content.replace(/<[^>]*>/g, '').substring(0, 160) + '...' : '')}
                              </p>
                            </div>
                            <div class="mt-4 flex items-center text-sm font-bold text-emerald-900 group-hover:translate-x-1 transition-transform">
                              READ MORE <ChevronRight className="w-3 h-3 ml-1" />
                            </div>
                          </div>
                        </div>
                      </CardContent>
                    </Card>
                  </a>
                );
              })
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>
