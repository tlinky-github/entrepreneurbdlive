---
export function getStaticPaths() {
  return [
    { params: { path: undefined } },
    { params: { path: 'content-editor' } },
    { params: { path: 'content-manager' } },
    { params: { path: 'test-editor' } },
    { params: { path: 'posts' } },
    { params: { path: 'authors' } },
    { params: { path: 'entrepreneurs' } },
    { params: { path: 'directory' } },
    { params: { path: 'directories' } },
    { params: { path: 'resources' } },
    { params: { path: 'media' } },
    { params: { path: 'traffic-center' } },
    { params: { path: 'users' } },
    { params: { path: 'taxonomies' } },
    { params: { path: 'knowledge-hub' } },
    { params: { path: 'pages' } },
    { params: { path: 'settings' } },
    { params: { path: 'ai-settings' } },
    { params: { path: 'analytics' } },
    { params: { path: 'submissions' } },
    { params: { path: 'reports' } },
    { params: { path: 'import' } },
    { params: { path: 'custom-code' } }
  ];
}

import AdminApp from '../../components/admin/AdminApp.jsx';
import { Toaster } from 'sonner';
import '../../styles/globals.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin Panel | Entrepreneurs BD</title>
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="bg-stone-100">
    <AdminApp client:only="react" />
    <Toaster client:only="react" position="top-right" richColors />
  </body>
</html>
