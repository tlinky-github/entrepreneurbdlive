// Firestore Security Rules for AI Collections
// Add this to your Firestore security rules in Firebase Console

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // AI Configurations - Store encrypted API keys
    match /ai_configs/{userId} {
      allow read, write: if isAuth() && isOwner(userId);
      
      // Only the owner can read/write their config
      allow delete: if isAuth() && isOwner(userId);
    }

    // AI Generated Posts
    match /ai_posts/{postId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid && 
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // AI Schedules
    match /ai_schedules/{scheduleId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid && 
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // AI Logs (audit trail)
    match /ai_logs/{logId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false; // Never delete logs for audit purposes
    }

    // Existing rules for other collections (keep as is)
    // ... your existing rules ...
  }
}
